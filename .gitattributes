# Preserve canonical tooling bytes without changing historical fixture attributes.
.engineering-backbone/src/** text eol=lf -filter -working-tree-encoding
.engineering-backbone/schemas/** text eol=lf -filter -working-tree-encoding
.engineering-backbone/requirements.txt text eol=lf -filter -working-tree-encoding
.engineering-backbone/requirements.lock text eol=lf -filter -working-tree-encoding

# Byte-attested history must stay identical in Windows autocrlf checkouts.
docs/changes/** text eol=lf -filter -working-tree-encoding
