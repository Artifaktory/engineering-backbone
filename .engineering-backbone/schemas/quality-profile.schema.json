{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-backbone:quality-profile",
  "title": "Versioned project quality profile",
  "description": "Structural declarations only. The trusted guard checks complete managed catalog authority, safe regular files, selected rule and PR check-kind bindings, traceability, exceptions and approved-base monotonic activation. It does not execute checks or authenticate reviewers, evidence claims or certification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "enabled",
    "catalog_version",
    "backbone_ref",
    "profiles",
    "documents",
    "checks",
    "exceptions"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "enabled": {
      "type": "boolean"
    },
    "catalog_version": {
      "const": "1.0.0"
    },
    "backbone_ref": {
      "anyOf": [
        {
          "const": ""
        },
        {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        }
      ]
    },
    "profiles": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 256,
      "items": {
        "enum": [
          "agentic",
          "baseline",
          "high-risk",
          "python",
          "software",
          "typescript"
        ]
      }
    },
    "documents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quality_plan",
        "test_strategy",
        "traceability",
        "exceptions"
      ],
      "properties": {
        "quality_plan": {
          "anyOf": [
            {
              "const": ""
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^(?!/)(?!.*[\\\\:])(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*[\\u0000-\\u001f\\u007f-\\u009f])[^/]+(?:/[^/]+)*$"
            }
          ]
        },
        "test_strategy": {
          "anyOf": [
            {
              "const": ""
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^(?!/)(?!.*[\\\\:])(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*[\\u0000-\\u001f\\u007f-\\u009f])[^/]+(?:/[^/]+)*$"
            }
          ]
        },
        "traceability": {
          "anyOf": [
            {
              "const": ""
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^(?!/)(?!.*[\\\\:])(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*[\\u0000-\\u001f\\u007f-\\u009f])[^/]+(?:/[^/]+)*$"
            }
          ]
        },
        "exceptions": {
          "anyOf": [
            {
              "const": ""
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^(?!/)(?!.*[\\\\:])(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*[\\u0000-\\u001f\\u007f-\\u009f])[^/]+(?:/[^/]+)*$"
            }
          ]
        }
      }
    },
    "checks": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "check_ids"
        ],
        "properties": {
          "rule_id": {
            "enum": [
              "QUAL-REQ-001",
              "QUAL-DES-001",
              "QUAL-CODE-001",
              "QUAL-TEST-001",
              "QUAL-DOC-001",
              "QUAL-EVID-001",
              "QUAL-REVIEW-001",
              "QUAL-HANDOFF-001",
              "QUAL-SW-001",
              "QUAL-SEC-001",
              "QUAL-PY-001",
              "QUAL-TS-001",
              "QUAL-HIGH-001",
              "QUAL-AGENT-001",
              "QUAL-CPP-001",
              "QUAL-IEC-001"
            ]
          },
          "check_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
            }
          }
        }
      }
    },
    "exceptions": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "scope",
          "reason",
          "owner",
          "approved_by",
          "expires_on",
          "compensating_check_ids",
          "evidence_path"
        ],
        "properties": {
          "rule_id": {
            "enum": [
              "QUAL-SW-001",
              "QUAL-SEC-001",
              "QUAL-PY-001",
              "QUAL-TS-001",
              "QUAL-HIGH-001",
              "QUAL-AGENT-001"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
          },
          "approved_by": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
          },
          "expires_on": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "compensating_check_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
            }
          },
          "evidence_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?!/)(?!.*[\\\\:])(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*[\\u0000-\\u001f\\u007f-\\u009f])[^/]+(?:/[^/]+)*$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        },
        "required": [
          "enabled"
        ]
      },
      "then": {
        "properties": {
          "backbone_ref": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{40}$"
          },
          "profiles": {
            "minItems": 1,
            "contains": {
              "const": "baseline"
            }
          },
          "documents": {
            "properties": {
              "quality_plan": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^(?!/)(?!.*[\\\\:])(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*[\\u0000-\\u001f\\u007f-\\u009f])[^/]+(?:/[^/]+)*$"
              },
              "test_strategy": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^(?!/)(?!.*[\\\\:])(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*[\\u0000-\\u001f\\u007f-\\u009f])[^/]+(?:/[^/]+)*$"
              },
              "traceability": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^(?!/)(?!.*[\\\\:])(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*[\\u0000-\\u001f\\u007f-\\u009f])[^/]+(?:/[^/]+)*$"
              }
            }
          },
          "checks": {
            "minItems": 1,
            "contains": {
              "properties": {
                "rule_id": {
                  "const": "QUAL-TEST-001"
                }
              },
              "required": [
                "rule_id"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "exceptions": {
            "minItems": 1
          }
        },
        "required": [
          "exceptions"
        ]
      },
      "then": {
        "properties": {
          "documents": {
            "properties": {
              "exceptions": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^(?!/)(?!.*[\\\\:])(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*[\\u0000-\\u001f\\u007f-\\u009f])[^/]+(?:/[^/]+)*$"
              }
            }
          }
        }
      }
    }
  ]
}
