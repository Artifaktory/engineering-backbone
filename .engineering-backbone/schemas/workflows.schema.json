{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-backbone:workflows",
  "title": "Shared workflow kit configuration",
  "description": "Structural contract. The trusted guard additionally enforces unique check IDs, bounded regular files, safe paths and approved-base authority. Disabled seeds may be incomplete; activation needs a complete already reviewed seed.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "enabled": {
      "type": "boolean"
    },
    "profiles": {
      "type": "array",
      "items": {
        "enum": [
          "docs",
          "python",
          "typescript",
          "go",
          "dotnet"
        ]
      },
      "uniqueItems": true,
      "maxItems": 5
    },
    "capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "dependencies",
          "web",
          "api",
          "database",
          "container",
          "iac",
          "release",
          "deploy"
        ]
      },
      "uniqueItems": true,
      "maxItems": 8
    },
    "runtimes": {
      "type": "object",
      "properties": {
        "python": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[0-9]{1,3}(?:\\.[0-9]{1,3}){0,2}$"
        },
        "node": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[0-9]{1,3}(?:\\.[0-9]{1,3}){0,2}$"
        },
        "go": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[0-9]{1,3}(?:\\.[0-9]{1,3}){0,2}$"
        },
        "dotnet": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[0-9]{1,3}(?:\\.[0-9]{1,3}){0,2}(?:\\.x)?$"
        }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/check"
      }
    }
  },
  "required": [
    "schema_version",
    "enabled",
    "profiles",
    "capabilities",
    "runtimes",
    "checks"
  ],
  "additionalProperties": false,
  "$defs": {
    "check": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        },
        "kind": {
          "enum": [
            "docs",
            "build",
            "lint",
            "test",
            "typecheck",
            "browser",
            "api",
            "migration",
            "sast",
            "dependency",
            "container",
            "iac",
            "release-integrity",
            "provenance",
            "signature",
            "sbom",
            "deployment-smoke",
            "rollback",
            "monitoring"
          ]
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "prefixItems": [
            {
              "type": "string",
              "maxLength": 4096,
              "pattern": "^[^\\u0000-\\u0020\\u007f-\\u009f][^\\u0000-\\u001f\\u007f-\\u009f]*$",
              "minLength": 1
            }
          ],
          "items": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
          }
        },
        "cwd": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^(?:\\.|(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\:\\u0000-\\u001f\\u007f-\\u009f]+(?<!/))$"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800
        },
        "phases": {
          "type": "array",
          "items": {
            "enum": [
              "pr",
              "maintenance",
              "release",
              "deploy"
            ]
          },
          "uniqueItems": true,
          "maxItems": 4,
          "minItems": 1
        }
      },
      "required": [
        "id",
        "kind",
        "argv",
        "cwd",
        "timeout_seconds",
        "phases"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "docs",
                  "build",
                  "lint",
                  "test",
                  "typecheck",
                  "browser",
                  "api",
                  "migration",
                  "sast",
                  "iac"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "phases": {
                "items": {
                  "enum": [
                    "pr"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "dependency",
                  "container"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "phases": {
                "items": {
                  "enum": [
                    "pr",
                    "maintenance"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "release-integrity",
                  "provenance",
                  "signature",
                  "sbom"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "phases": {
                "items": {
                  "enum": [
                    "release"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "deployment-smoke",
                  "rollback",
                  "monitoring"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "phases": {
                "items": {
                  "enum": [
                    "deploy"
                  ]
                }
              }
            }
          }
        }
      ]
    }
  },
