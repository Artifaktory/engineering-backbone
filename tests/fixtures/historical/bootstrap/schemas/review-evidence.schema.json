{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-backbone:review-evidence",
  "title": "review-evidence",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "full",
        "delta",
        "triage"
      ]
    },
    "subject": {
      "type": "object",
      "properties": {
        "base_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "head_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "required": [
        "base_revision",
        "head_revision"
      ],
      "additionalProperties": false
    },
    "implementer": {
      "type": "string",
      "minLength": 1
    },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "const": "independent_reviewer"
          }
        },
        "required": [
          "id",
          "role"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "outcome": {
      "enum": [
        "pending",
        "changes_requested",
        "no_findings"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pending",
              "pass",
              "fail",
              "blocked"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "name",
          "status",
          "evidence"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "pass"
                }
              }
            },
            "then": {
              "properties": {
                "evidence": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "location": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
              },
              "line": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "path",
              "line"
            ],
            "additionalProperties": false
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "triage": {
            "enum": [
              "untriaged",
              "confirmed",
              "rejected",
              "deferred"
            ]
          },
          "disposition": {
            "enum": [
              "proposed",
              "fixed",
              "not_applicable"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "severity",
          "location",
          "claim",
          "evidence",
          "triage",
          "disposition"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "triage": {
                  "enum": [
                    "rejected",
                    "deferred"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "reason"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "disposition": {
                  "const": "fixed"
                }
              }
            },
            "then": {
              "properties": {
                "triage": {
                  "const": "confirmed"
                }
              }
            }
          }
        ]
      }
    },
    "delta": {
      "type": "object",
      "properties": {
        "finding_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "regressions_checked": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        }
      },
      "required": [
        "finding_ids",
        "regressions_checked"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "kind",
    "subject",
    "implementer",
    "reviewers",
    "outcome",
    "checks",
    "findings"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "delta"
          }
        }
      },
      "then": {
        "required": [
          "delta"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "no_findings"
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "maxItems": 0
          },
          "checks": {
            "minItems": 1,
            "items": {
              "properties": {
                "status": {
                  "const": "pass"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "changes_requested"
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
