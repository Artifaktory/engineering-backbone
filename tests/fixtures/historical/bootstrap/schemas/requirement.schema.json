{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-backbone:requirement",
  "title": "requirement",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "technical",
        "nontechnical"
      ]
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "description"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "approval": {
      "enum": [
        "draft",
        "approved",
        "rejected"
      ]
    },
    "implementation": {
      "enum": [
        "not_started",
        "in_progress",
        "implemented"
      ]
    },
    "verification": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "automatic",
            "manual",
            "hybrid"
          ]
        },
        "status": {
          "enum": [
            "not_run",
            "pass",
            "fail",
            "blocked"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "mode",
        "status",
        "evidence"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "title",
    "type",
    "statement",
    "acceptance_criteria",
    "approval",
    "implementation",
    "verification"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "verification": {
            "properties": {
              "status": {
                "const": "pass"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "verification": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          },
          "implementation": {
            "const": "implemented"
          }
        }
      }
    }
  ]
}
