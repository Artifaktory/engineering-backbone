{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-backbone:dependencies",
  "title": "Project dependency compatibility contract",
  "description": "Optional project-owned declaration. The trusted guard verifies safe existing nonempty exact files, component coverage, active prerequisites, effective PR checks, activation and inherited requirements. Structural validation does not establish behavioral compatibility.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "enabled", "components"],
  "properties": {
    "schema_version": {"const": "1"},
    "enabled": {"type": "boolean"},
    "components": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/component"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"enabled": {"const": true}}},
      "then": {"properties": {"components": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"},
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*[\\\\:<>\"|?*#])(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*[\\u0000-\\u001f\\u007f-\\u009f])[^/]+(?:/[^/]+)*$"
    },
    "paths": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/path"}
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "compatibility_document", "manifests", "resolution_files", "runtime_files", "dockerfiles", "check_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["application", "library", "tooling"]},
        "compatibility_document": {"$ref": "#/$defs/path"},
        "manifests": {"$ref": "#/$defs/paths", "minItems": 1},
        "resolution_files": {"$ref": "#/$defs/paths"},
        "runtime_files": {"$ref": "#/$defs/paths"},
        "dockerfiles": {"$ref": "#/$defs/paths"},
        "check_ids": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"enum": ["application", "tooling"]}}},
          "then": {"properties": {"resolution_files": {"minItems": 1}}}
        }
      ]
    }
  }
}
